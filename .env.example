# Fixture mode is deterministic and needs no provider or database credentials.
ASTRAOPS_DATA_MODE=fixture

# Required only when ASTRAOPS_DATA_MODE=live.
DATABASE_URL=

# Optional server-only key for NASA DONKI event context. NOAA remains available without it.
NASA_API_KEY=

# Absolute public origin used for metadata and share links.
SITE_URL=http://localhost:3000

# Required for production reconciliation endpoints; omit in fixture mode.
CRON_SECRET=
